# zai2api configuration example — copy to .env and adjust

# ---- downstream (clients -> zai2api) ----
# API keys clients must present; comma-separated. Empty = open access.
AUTH_TOKENS=sk-my-secret-key-1,sk-my-secret-key-2
# Admin panel password (http://host:8000/admin/)
ADMIN_PASSWORD=change-me-please

# ---- upstream (zai2api -> chat.z.ai) ----
# Z.ai account JWTs from browser localStorage (chat.z.ai -> F12 -> Application
# -> Local Storage -> token). Unlocks GLM-5.x family, vision, file upload.
# Comma-separated; multiple tokens are pooled and rotated. JWTs are decoded
# to read user_id for request signing.
ZAI_TOKENS=
# Anonymous guest-token mode fallback (glm-4.7-class text models only).
ANONYMOUS_MODE=true

# Model returned when client sends an unknown model name (default glm-4.7)
DEFAULT_MODEL=glm-4.7
# reasoning output: reasoning (OpenAI reasoning_content) | think (<think>) | strip
THINK_TAGS_MODE=reasoning

# ---- network ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Egress proxy for upstream httpx calls (browser session ignores this;
# use system proxy for camoufox if needed)
UPSTREAM_PROXY=

# ---- captcha / browser session ----
# The chat.z.ai v2 API requires an Aliyun traceless captcha token that is
# bound to the browser fingerprint. zai2api therefore runs a persistent
# camoufox (anti-fingerprint Firefox) page and issues chat requests from
# inside it. Disable only for protocol testing.
CAPTCHA_ENABLED=true
# Explicit path to the camoufox binary (auto-detected from LOCALAPPDATA
# or the camoufox-managed download dir when unset).
# CAMOUFOX_PATH=C:\Users\you\AppData\Local\camoufox\camoufox\Cache\camoufox.exe
